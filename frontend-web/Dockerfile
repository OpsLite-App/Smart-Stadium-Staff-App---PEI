FROM node:22-alpine

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

ARG API_GATEWAY_URL=http://traefik-gateway:8080
ARG AUTH_SERVICE_URL=http://auth-service:8081
ARG CONGESTION_SERVICE_URL=http://congestion-service:8005
ARG EMERGENCY_SERVICE_URL=http://emergency-service:8006
ARG MAINTENANCE_SERVICE_URL=http://maintenance-service:8007
ARG QUEUEING_SERVICE_URL=http://queueing-service:8003
ARG ROUTING_SERVICE_URL=http://routing-service:8002
ARG CHAT_SERVICE_URL=http://chat-service:8000
ARG POSITIONING_SERVICE_URL=http://positioning-service:8004

ENV API_GATEWAY_URL=$API_GATEWAY_URL
ENV AUTH_SERVICE_URL=$AUTH_SERVICE_URL
ENV CONGESTION_SERVICE_URL=$CONGESTION_SERVICE_URL
ENV EMERGENCY_SERVICE_URL=$EMERGENCY_SERVICE_URL
ENV MAINTENANCE_SERVICE_URL=$MAINTENANCE_SERVICE_URL
ENV QUEUEING_SERVICE_URL=$QUEUEING_SERVICE_URL
ENV ROUTING_SERVICE_URL=$ROUTING_SERVICE_URL
ENV CHAT_SERVICE_URL=$CHAT_SERVICE_URL
ENV POSITIONING_SERVICE_URL=$POSITIONING_SERVICE_URL

COPY package*.json ./
RUN npm ci

COPY . .

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-H", "0.0.0.0"]
