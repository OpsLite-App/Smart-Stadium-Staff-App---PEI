---
import '../../styles/global.css';

const backgroundImage = "/dragao.jpg";
const logoImage = "/logo.jpeg";

const actors = [
  { 
    role: "Operations Manager", 
    desc: "Overall stadium supervision", 
    respons: "Strategic decisions, incident assignment, emergency mode activation.",
    emoji: "🏢"
  },
  { 
    role: "Zone Supervisor", 
    desc: "Manages specific stadium areas", 
    respons: "Local incident management, team communication, zone monitoring.",
    emoji: "👮"
  },
  { 
    role: "Field Staff", 
    desc: "Security, cleaning, and emergency personnel", 
    respons: "Incident response, navigation, on-site actions, status reporting.",
    emoji: "🏃"
  },
  { 
    role: "System", 
    desc: "Automated components", 
    respons: "Alert generation, route calculation, data processing.",
    emoji: "🤖"
  }
];

const useCaseGroups = [
  {
    title: "Situational Awareness",
    image: "/use-cases/awareness-usecase.png",
    cases: ["UC01: View Heatmap", "UC02: View Staff Location", "UC03: Filter Staff by Type/Status"]
  },
  {
    title: "Incident Management",
    image: "/use-cases/incident-usecase.png",
    cases: ["UC04: Report Incident", "UC05: Receive Automatic Alert", "UC06: View Incident List", "UC07: Assign Incident", "UC08: Accept/Reject Incident"]
  },
  {
    title: "Navigation & Routes",
    image: "/use-cases/navigation-usecase.png",
    cases: ["UC09: Calculate Route to Incident", "UC10: Navigate to Points of Interest"]
  },
  {
    title: "Emergency",
    image: "/use-cases/emergency-usecase.png",
    cases: ["UC11: Activate Emergency Mode", "UC12: View Evacuation Routes", "UC13: View Emergency Instructions"]
  },
  {
    title: "Communication",
    image: "/use-cases/communication-usecase.png",
    cases: ["UC14: Group Chat", "UC15: Geographic Zone Chat", "UC16: SOS Button"]
  },
  {
    title: "Operations",
    image: "/use-cases/operation-usecase.png",
    cases: ["UC17: Consult Operational Dashboard"]
  }
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Use Cases | OpsLite</title>
		<link rel="icon" type="image/jpeg" href={logoImage} />
	</head>
	<body class="bg-slate-50 text-slate-900 antialiased font-sans flex flex-col min-h-screen">
		
		<div class="fixed inset-0 -z-10 overflow-hidden">
			<img src={backgroundImage} alt="Stadium Background" class="w-full h-full object-cover opacity-35 shadow-inner" />
			<div class="absolute inset-0 bg-gradient-to-tr from-slate-50 via-slate-50/80 to-transparent"></div>
		</div>

		<nav class="fixed top-0 left-0 right-0 z-50 bg-white/40 backdrop-blur-md border-b border-white/20">
		    <div class="max-w-6xl mx-auto px-8 h-20 flex items-center justify-between">
		        <a href="/" class="flex items-center gap-3 group">
		            <img src={logoImage} alt="OpsLite Logo" class="h-10 w-auto rounded-lg shadow-sm group-hover:scale-105 transition-transform" />
		            <span class="font-black tracking-tighter text-slate-900 uppercase">OpsLite</span>
		        </a>
			
		        <div class="hidden md:flex items-center gap-8 text-[10px] font-bold tracking-[0.2em] uppercase text-slate-600">
		            <a href="/overview" class="hover:text-blue-700 transition-colors">Overview</a>
		            <a href="/team" class="hover:text-blue-700 transition-colors">Team</a>
		            <a href="/milestones" class="hover:text-blue-700 transition-colors">Milestones</a>
				
		            <div class="relative group/dropdown py-4">
		                <button class="flex items-center gap-1 uppercase tracking-[0.2em] hover:text-blue-700 transition-colors cursor-default">
		                    Documents
		                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover/dropdown:rotate-180 transition-transform">
		                        <path d="m6 9 6 6 6-6"/>
		                    </svg>
		                </button>
					
		                <div class="absolute top-full left-1/2 -translate-x-1/2 w-48 pt-2 invisible opacity-0 group-hover/dropdown:visible group-hover/dropdown:opacity-100 transition-all duration-200">
		                    <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-2xl shadow-xl p-2 flex flex-col gap-1">
		                        <a href="/documents/use-cases" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">
		                            Use Cases
		                        </a>
		                        <a href="/documents/architecture" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">
		                            Architecture
		                        </a>
		                        <a href="/documents/api" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">
		                            API
		                        </a>
		                        <a href="/documents/technologies" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">
		                            Technologies
		                        </a>
		                    </div>
		                </div>
		            </div>
		        </div>
		    </div>
		</nav>

		<main class="min-h-screen flex flex-col px-8 pt-28 pb-6 max-w-6xl mx-auto relative">
			
			<header class="mt-8 mb-12">
				<h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-[0.9] text-slate-950 uppercase">
					Use <span class="text-blue-700 font-black">Cases</span>
				</h1>
				<div class="h-2 w-20 bg-blue-700 mt-6 rounded-full"></div>
			</header>

			<section class="mb-16">
			    <h2 class="text-[10px] font-bold tracking-[0.5em] text-blue-700 uppercase mb-6">System Actors</h2>
			    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			        {actors.map(actor => (
			            <div class="group p-6 bg-white/40 backdrop-blur-md border border-white/60 rounded-3xl hover:bg-white/60 hover:border-blue-300 transition-all duration-300 shadow-sm flex flex-row items-center gap-6 cursor-default">
			                
			                {/* Avatar Visual similar à página Team */}
			                <div class="w-20 h-20 md:w-24 md:h-24 bg-slate-200 rounded-2xl flex items-center justify-center border-2 border-white shadow-inner shrink-0 transition-all group-hover:bg-blue-50">
			                    <span class="text-4xl">{actor.emoji}</span>
			                </div>
						
			                <div class="flex flex-col min-w-0">
			                    <h3 class="text-xl font-bold text-slate-950 mb-0.5 tracking-tight">{actor.role}</h3>
			                    <p class="text-[10px] font-bold text-blue-700 uppercase tracking-widest mb-3 leading-tight">
			                        {actor.desc}
			                    </p>
			                    <div class="text-xs text-slate-600 leading-snug flex items-start gap-2">
			                        <span class="text-blue-500 font-bold">•</span>
			                        <span>{actor.respons}</span>
			                    </div>
			                </div>
			            </div>
			        ))}
			    </div>
			</section>

			<div class="flex flex-col gap-20 mb-20">
				{useCaseGroups.map((group) => (
					<section class="group">
						<div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-start">
							<div class="lg:col-span-2">
								<h2 class="text-2xl font-black tracking-tighter text-slate-900 uppercase mb-4">
									{group.title}
								</h2>
								<ul class="flex flex-col gap-3">
									{group.cases.map(uc => (
										<li class="flex items-center gap-3 text-slate-600 text-sm">
											<span class="h-1.5 w-1.5 bg-blue-700 rounded-full shrink-0"></span>
											{uc}
										</li>
									))}
								</ul>
							</div>
							
							<div class="lg:col-span-3 bg-white/40 backdrop-blur-md p-4 rounded-3xl border border-white/60 shadow-sm overflow-hidden transition-all duration-500 hover:shadow-2xl hover:border-blue-200/50">
								<img 
									src={group.image} 
									alt={`${group.title} Diagram`} 
									class="w-full h-auto rounded-xl transition-transform duration-500 group-hover:scale-[1.02]"
								/>
							</div>
						</div>
					</section>
				))}
			</div>

			<footer class="mt-auto pt-4 border-t border-slate-300/50 flex flex-wrap gap-x-8 gap-y-2 text-slate-500 text-[10px] font-mono tracking-widest uppercase mb-2">
			    <div class="flex gap-6">
			        <span>PEI 2025/2026</span>
			        <span class="font-bold text-slate-700">University of Aveiro</span>
			    </div>
			    <a href="https://github.com/OpsLite-App" target="_blank" rel="noopener noreferrer" class="ml-auto flex items-center gap-2 hover:text-blue-700 transition-colors group normal-case">
				    <span class="text-slate-400 group-hover:text-blue-700 italic">GitHub</span>
				    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                        <path d="M9 18c-4.51 2-5-2-7-2"></path>
                    </svg>
				</a>
			</footer>

		</main>
	</body>
</html>