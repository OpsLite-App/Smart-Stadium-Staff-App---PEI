---
// source: 54
import '../../styles/global.css';

const backgroundImage = "/Smart-Stadium-Staff-App---PEI/dragao.jpg";
const logoImage = "/Smart-Stadium-Staff-App---PEI/logo.jpeg";

const apiSections = [
  {
    id: "auth",
    service: "Auth Service",
    port: 8081,
    icon: "🔐",
    endpoints: [
      { method: "POST", path: "/auth/login", desc: "User authentication" },
      { method: "POST", path: "/auth/validate", desc: "Token validation" },
      { method: "GET", path: "/auth/me", desc: "Current user data" },
      { method: "GET", path: "/auth/staff", desc: "List staff members" },
    ]
  },
  {
    id: "map",
    service: "Map Service",
    port: 8000,
    icon: "🗺️",
    endpoints: [
      { method: "GET", path: "/api/map", desc: "Full map (nodes, edges, closures)" },
      { method: "GET", path: "/api/nodes", desc: "All nodes" },
      { method: "GET", path: "/api/nodes/{id}", desc: "Specific node" },
      { method: "PUT", path: "/api/nodes/{id}", desc: "Update node" },
      { method: "GET", path: "/api/edges", desc: "All edges" },
      { method: "GET", path: "/api/edges/{id}", desc: "Specific edge" },
      { method: "PUT", path: "/api/edges/{id}", desc: "Update edge" },
      { method: "GET", path: "/api/closures", desc: "All closures" },
      { method: "GET", path: "/api/closures/{id}", desc: "Specific closure" },
      { method: "POST", path: "/api/closures", desc: "Create closure" },
      { method: "DELETE", path: "/api/closures/{id}", desc: "Remove closure" },
      { method: "GET", path: "/api/tiles", desc: "All tiles" },
      { method: "GET", path: "/api/tiles/{id}", desc: "Specific tile" },
      { method: "PUT", path: "/api/tiles/{id}", desc: "Update tile" },
      { method: "GET", path: "/api/pois", desc: "All Points of Interest" },
      { method: "GET", path: "/api/pois/{id}", desc: "Specific POI" },
      { method: "PUT", path: "/api/pois/{id}", desc: "Update POI" },
      { method: "GET", path: "/api/seats", desc: "All seats" },
      { method: "GET", path: "/api/seats/{id}", desc: "Specific seat" },
      { method: "PUT", path: "/api/seats/{id}", desc: "Update seat" },
      { method: "GET", path: "/api/gates", desc: "All gates" },
      { method: "GET", path: "/api/gates/{id}", desc: "Specific gate" },
      { method: "PUT", path: "/api/gates/{id}", desc: "Update gate" },
      { method: "GET", path: "/health", desc: "Health check" },
      { method: "POST", path: "/api/reset", desc: "Database reset" },
    ]
  },
  {
    id: "routing",
    service: "Routing Service",
    port: 8002,
    icon: "📍",
    endpoints: [
      { method: "GET", path: "/api/route", desc: "Calculate route (A*)" },
      { method: "POST", path: "/api/route/multi", desc: "Multi-destination route" },
      { method: "POST", path: "/api/route/nearest", desc: "Nearest node" },
      { method: "GET", path: "/api/route/evacuation", desc: "Evacuation route" },
      { method: "POST", path: "/api/hazards/closure", desc: "Add closure hazard" },
      { method: "DELETE", path: "/api/hazards/closure", desc: "Remove closure hazard" },
      { method: "POST", path: "/api/hazards/update", desc: "Update hazard on node" },
      { method: "POST", path: "/api/hazards/crowd", desc: "Update crowd penalty" },
      { method: "DELETE", path: "/api/hazards/clear", desc: "Clear hazards from node" },
      { method: "GET", path: "/api/hazards/status", desc: "Hazards status" },
      { method: "POST", path: "/api/reload", desc: "Reload graph from Map Service" },
      { method: "GET", path: "/health", desc: "Health check" },
    ]
  },
  {
    id: "congestion",
    service: "Congestion Service",
    port: 8003,
    icon: "📊",
    endpoints: [
      { method: "GET", path: "/api/heatmap", desc: "Full heatmap" },
      { method: "GET", path: "/api/heatmap/points", desc: "Heatmap points" },
      { method: "GET", path: "/api/heatmap/{area_id}", desc: "Area density" },
      { method: "GET", path: "/api/heatmap/by-type/{area_type}", desc: "Heatmap by type" },
      { method: "GET", path: "/api/congestion/alerts", desc: "Congestion alerts" },
      { method: "GET", path: "/api/congestion/summary", desc: "General summary" },
      { method: "GET", path: "/api/congestion/history/{area_id}", desc: "Area history" },
      { method: "GET", path: "/api/congestion/hotspots", desc: "Most congested zones" },
      { method: "GET", path: "/api/congestion/safest-areas", desc: "Safest zones" },
      { method: "GET", path: "/api/congestion/trends", desc: "Trends" },
      { method: "GET", path: "/health", desc: "Health check" },
    ]
  },
  {
    id: "queueing",
    service: "Queueing Service",
    port: 8004,
    icon: "⏳",
    endpoints: [
      { method: "POST", path: "/api/queue/update", desc: "Update queue status" },
      { method: "GET", path: "/api/queue/waittime/{location_id}", desc: "Estimated wait time" },
      { method: "POST", path: "/api/queue/calculate", desc: "Calculate time (stateless)" },
      { method: "GET", path: "/api/queue/status", desc: "Status of all queues" },
      { method: "GET", path: "/api/queue/alerts", desc: "Queues above threshold" },
      { method: "GET", path: "/api/queue/compare", desc: "Compare N-server scenarios" },
      { method: "DELETE", path: "/api/queue/{location_id}", desc: "Remove queue from tracking" },
    ]
  },
  {
    id: "maintenance",
    service: "Maintenance Service",
    port: 8006,
    icon: "🔧",
    endpoints: [
      { method: "GET", path: "/api/maintenance/status", desc: "Service status" },
      { method: "POST", path: "/api/maintenance/bins/alert", desc: "Create full bin alert" },
      { method: "GET", path: "/api/maintenance/bins/alerts", desc: "List bin alerts" },
      { method: "POST", path: "/api/maintenance/tasks", desc: "Create task" },
      { method: "GET", path: "/api/maintenance/tasks", desc: "List tasks" },
      { method: "GET", path: "/api/maintenance/tasks/{id}", desc: "Task details" },
      { method: "PATCH", path: "/api/maintenance/tasks/{id}", desc: "Update task" },
      { method: "DELETE", path: "/api/maintenance/tasks/{id}", desc: "Delete task" },
      { method: "POST", path: "/api/maintenance/tasks/{id}/complete", desc: "Mark as complete" },
      { method: "POST", path: "/api/maintenance/tasks/{id}/start", desc: "Mark as in progress" },
      { method: "POST", path: "/api/maintenance/assign", desc: "Manual task assignment" },
      { method: "POST", path: "/api/maintenance/assign/auto/{task_id}", desc: "Automatic assignment" },
      { method: "POST", path: "/api/maintenance/assign/batch", desc: "Batch assignment" },
      { method: "POST", path: "/api/maintenance/staff/register", desc: "Register staff" },
      { method: "PATCH", path: "/api/maintenance/staff/{id}/location", desc: "Update location" },
      { method: "PATCH", path: "/api/maintenance/staff/{id}/availability", desc: "Update availability" },
      { method: "GET", path: "/api/maintenance/staff", desc: "List staff" },
      { method: "GET", path: "/api/maintenance/staff/available", desc: "Available staff" },
      { method: "GET", path: "/api/maintenance/staff/{id}/tasks", desc: "Staff member tasks" },
      { method: "GET", path: "/api/maintenance/stats", desc: "General statistics" },
      { method: "GET", path: "/api/maintenance/stats/staff/{id}", desc: "Staff statistics" },
    ]
  },
  {
    id: "emergency",
    service: "Emergency Service",
    port: 8007,
    icon: "🚨",
    endpoints: [
      { method: "GET", path: "/api/emergency/status", desc: "Service status" },
      { method: "POST", path: "/api/emergency/incidents", desc: "Create incident" },
      { method: "GET", path: "/api/emergency/incidents", desc: "List incidents" },
      { method: "GET", path: "/api/emergency/incidents/{id}", desc: "Incident details" },
      { method: "PATCH", path: "/api/emergency/incidents/{id}", desc: "Update incident" },
      { method: "POST", path: "/api/emergency/incidents/{id}/escalate", desc: "Escalate incident" },
      { method: "POST", path: "/api/emergency/incidents/{id}/resolve", desc: "Resolve incident" },
      { method: "POST", path: "/api/emergency/sensors/alert", desc: "Create sensor alert" },
      { method: "GET", path: "/api/emergency/sensors/alerts", desc: "List sensor alerts" },
      { method: "POST", path: "/api/emergency/dispatch", desc: "Dispatch responders" },
      { method: "POST", path: "/api/emergency/dispatch/manual", desc: "Manual dispatch" },
      { method: "GET", path: "/api/emergency/dispatch/active", desc: "Active dispatches" },
      { method: "POST", path: "/api/emergency/dispatch/{id}/arrived", desc: "Mark arrival" },
      { method: "POST", path: "/api/emergency/evacuation", desc: "Initiate evacuation" },
      { method: "GET", path: "/api/emergency/evacuation/active", desc: "Active evacuations" },
      { method: "GET", path: "/api/emergency/evacuation/{id}", desc: "Evacuation details" },
      { method: "POST", path: "/api/emergency/evacuation/{id}/complete", desc: "Complete evacuation" },
      { method: "GET", path: "/api/emergency/stats", desc: "Statistics" },
      { method: "GET", path: "/api/emergency/stats/timeline", desc: "Incident timeline" },
    ]
  }
];

const getMethodColor = (method) => {
  switch (method) {
    case 'GET': return 'text-sky-600 bg-sky-100/50 border-sky-200';
    case 'POST': return 'text-emerald-600 bg-emerald-100/50 border-emerald-200';
    case 'PUT': return 'text-amber-600 bg-amber-100/50 border-amber-200';
    case 'PATCH': return 'text-violet-600 bg-violet-100/50 border-violet-200';
    case 'DELETE': return 'text-red-600 bg-red-100/50 border-red-200';
    default: return 'text-slate-600 bg-slate-100/50 border-slate-200';
  }
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>API | OpsLite</title>
		<link rel="icon" type="image/jpeg" href={logoImage} />
        
        <script is:inline>
            function openTab(evt, tabId) {
                const tabContents = document.getElementsByClassName("tab-content");
                for (let i = 0; i < tabContents.length; i++) {
                    tabContents[i].classList.add("hidden");
                }

                const tabButtons = document.getElementsByClassName("tab-button");
                for (let i = 0; i < tabButtons.length; i++) {
                    tabButtons[i].classList.remove("active", "border-blue-400", "ring-4", "ring-blue-50/50", "bg-white/90");
                    tabButtons[i].classList.add("border-white/60");
                }

                document.getElementById(tabId).classList.remove("hidden");
                evt.currentTarget.classList.add("active", "border-blue-400", "ring-4", "ring-blue-50/50", "bg-white/90");
                evt.currentTarget.classList.remove("border-white/60");
                
                localStorage.setItem('activeApiTab', tabId);
            }

            window.onload = function() {
                const activeTabId = localStorage.getItem('activeApiTab') || 'auth';
                const defaultTab = document.querySelector(`[onclick*="openTab(event, '${activeTabId}')"]`);
                if (defaultTab) {
                    defaultTab.click();
                }
            };
        </script>
	</head>
	<body class="bg-slate-50 text-slate-900 antialiased font-sans flex flex-col min-h-screen">
		
		<div class="fixed inset-0 -z-10 overflow-hidden">
			<img src={backgroundImage} alt="Stadium Background" class="w-full h-full object-cover opacity-35 shadow-inner" />
			<div class="absolute inset-0 bg-gradient-to-tr from-slate-50 via-slate-50/80 to-transparent"></div>
		</div>

		<nav class="fixed top-0 left-0 right-0 z-50 bg-white/40 backdrop-blur-md border-b border-white/20">
		    <div class="max-w-6xl mx-auto px-8 h-20 flex items-center justify-between">
		        <a href="/Smart-Stadium-Staff-App---PEI/" class="flex items-center gap-3 group">
		            <img src={logoImage} alt="OpsLite Logo" class="h-10 w-auto rounded-lg shadow-sm group-hover:scale-105 transition-transform" />
		            <span class="font-black tracking-tighter text-slate-900 uppercase">OpsLite</span>
		        </a>
			
		        <div class="hidden md:flex items-center gap-8 text-[10px] font-bold tracking-[0.2em] uppercase text-slate-600">
		            <a href="/Smart-Stadium-Staff-App---PEI/overview" class="hover:text-blue-700 transition-colors">Overview</a>
		            <a href="/Smart-Stadium-Staff-App---PEI/team" class="hover:text-blue-700 transition-colors">Team</a>
                    
		            <div class="relative group/dropdown py-4">
		                <button class="flex items-center gap-1 uppercase tracking-[0.2em] hover:text-blue-700 transition-colors cursor-default">
		                    Milestones
		                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover/dropdown:rotate-180 transition-transform">
		                        <path d="m6 9 6 6 6-6"/>
		                    </svg>
		                </button>
					
		                <div class="absolute top-full left-1/2 -translate-x-1/2 w-48 pt-2 invisible opacity-0 group-hover/dropdown:visible group-hover/dropdown:opacity-100 transition-all duration-200">
		                    <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-2xl shadow-xl p-2 flex flex-col gap-1">
		                       <a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-1" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 1</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-2" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 2</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-2_1" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 2.1.</a>
								<a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-2_2" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 2.2.</a>
								<a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-3" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 3</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-4" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 4</a>
								<a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-5" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 5</a>
								<a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-6" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 6</a>
		                    </div>
		                </div>
		            </div>
				
		            <div class="relative group/dropdown py-4">
		                <button class="flex items-center gap-1 uppercase tracking-[0.2em] hover:text-blue-700 transition-colors cursor-default">
		                    Documents
		                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover/dropdown:rotate-180 transition-transform">
		                        <path d="m6 9 6 6 6-6"/>
		                    </svg>
		                </button>
					
		                <div class="absolute top-full left-1/2 -translate-x-1/2 w-48 pt-2 invisible opacity-0 group-hover/dropdown:visible group-hover/dropdown:opacity-100 transition-all duration-200">
		                    <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-2xl shadow-xl p-2 flex flex-col gap-1">
		                        <a href="/Smart-Stadium-Staff-App---PEI/documents/use-cases" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Use Cases</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/documents/architecture" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Architecture</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/documents/api" class="px-4 py-2.5 rounded-xl bg-blue-50 text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold">API</a>
                                <a href="/Smart-Stadium-Staff-App---PEI/documents/poster" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Poster</a> 
		                    </div>
		                </div>
		            </div>

                    <div class="relative group/dropdown py-4"> 
		                <button class="flex items-center gap-1 uppercase tracking-[0.2em] hover:text-blue-700 transition-colors cursor-default">
		                    Videos 
		                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover/dropdown:rotate-180 transition-transform">
		                        <path d="m6 9 6 6 6-6"/> 
		                    </svg>
		                </button>
					
		                <div class="absolute top-full left-1/2 -translate-x-1/2 w-48 pt-2 invisible opacity-0 group-hover/dropdown:visible group-hover/dropdown:opacity-100 transition-all duration-200">
		                    <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-2xl shadow-xl p-2 flex flex-col gap-1"> 
		                        <a href="/Smart-Stadium-Staff-App---PEI/videos/demo" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Demo</a> 
		                        <a href="/Smart-Stadium-Staff-App---PEI/videos/promotional" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Promotional</a> 
		                    </div>
		                </div>
		            </div>
		        </div>
		    </div>
		</nav>

		<main class="min-h-screen flex flex-col px-8 pt-28 pb-6 max-w-6xl mx-auto relative w-full">
			
			<div class="flex-grow flex flex-col gap-10">
				
				<header class="mt-8">
					<h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-[0.9] text-slate-950 uppercase">
						Backend <span class="text-blue-700 font-black">API</span>
					</h1>
					<div class="h-2 w-20 bg-blue-700 mt-6 rounded-full"></div>
				</header>

                <section>
                    <h2 class="text-[10px] font-bold tracking-[0.5em] text-slate-500 uppercase mb-6">Select a Microservice</h2>
                    
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
                        {apiSections.map((section) => (
                            <button 
                                class="tab-button group p-6 bg-white/40 backdrop-blur-md border border-white/60 rounded-3xl hover:bg-white/60 hover:border-blue-300 transition-all duration-300 shadow-sm flex flex-col items-center text-center gap-4 active:scale-[0.98]"
                                onclick={`openTab(event, '${section.id}')`}
                            >
                                <div class="w-14 h-14 bg-slate-200 rounded-2xl flex items-center justify-center border-2 border-white shadow-inner shrink-0 transition-colors group-hover:bg-blue-50">
                                    <span class="text-2xl transition-transform group-hover:scale-110">{section.icon}</span>
                                </div>
                                <div class="flex flex-col min-w-0">
                                    <h3 class="text-sm font-bold text-slate-950 tracking-tight group-hover:text-blue-700 transition-colors">{section.service}</h3>
                                    <span class="text-[8px] font-mono text-slate-400 uppercase tracking-widest leading-none mt-1">
                                        Port {section.port}
                                    </span>
                                </div>
                            </button>
                        ))}
                    </div>
                </section>

				<div class="space-y-8 mb-20 relative z-10">
					{apiSections.map((section) => (
						<section id={section.id} class="tab-content hidden animate-fade-in">
							<div class="bg-white/40 backdrop-blur-md p-6 md:p-8 rounded-[2.5rem] border border-white/60 shadow-sm space-y-3">
								{section.endpoints.map((endpoint) => (
									<div class="grid grid-cols-[80px,1fr] md:grid-cols-[100px,1fr,280px] items-center gap-x-6 gap-y-1 p-4 bg-white/60 rounded-2xl border border-white/80 hover:border-blue-200 hover:bg-white/90 transition-all group">
										
