---
import '../styles/global.css';
import * as icons from 'simple-icons';

const backgroundImage = "/Smart-Stadium-Staff-App---PEI/dragao.jpg";
const logoImage = "/Smart-Stadium-Staff-App---PEI/logo.jpeg";

const getIconWithColor = (iconName) => {
  const icon = icons[iconName];
  if (!icon) return null;
  
  return icon.svg.replace('<svg', `<svg fill="#${icon.hex}" class="tech-svg-source"`);
};

const techStack = [
  { 
    category: "Frontend", 
    items: [
      { name: "React + Next.js", type: "Framework", icon: "siReact" },
      { name: "Riverpod", type: "State Management", icon: null }, 
      { name: "WebSocket", type: "Real-time", icon: "siSocketdotio" }
    ]
  },
  { 
    category: "Backend", 
    items: [
      { name: "Java 17 (Spring)", type: "Language", icon: "siOpenjdk" },
      { name: "PostgreSQL 15", type: "Database", icon: "siPostgresql" },
      { name: "MQTT", type: "Message Broker", icon: "siHivemq" },
      { name: "Docker", type: "Containerization", icon: "siDocker" }
    ]
  }
];

const kpis = [
  { label: "Response Time", value: "< 60s", detail: "For emergency alerts" },
  { label: "Accuracy", value: "> 90%", detail: "Wait-time prediction" },
  { label: "Uptime", value: "99.9%", detail: "During live events" },
  { label: "Usability", value: "> 80", detail: "SUS Score" }
];
---

<html lang="pt">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Overview | OpsLite</title>
		<link rel="icon" type="image/jpeg" href={logoImage} />
        <style is:global>
            .tech-svg-container svg {
                width: 1.2em; 
                height: 1.2em;
                display: inline-block;
                vertical-align: -0.2em; 
            }
        </style>
	</head>
	<body class="bg-slate-50 text-slate-900 antialiased font-sans flex flex-col min-h-screen">
		
		<div class="fixed inset-0 -z-10 overflow-hidden">
			<img src={backgroundImage} alt="Estádio do Dragão" class="w-full h-full object-cover opacity-35 shadow-inner" />
			<div class="absolute inset-0 bg-gradient-to-tr from-slate-50 via-slate-50/80 to-transparent"></div>
		</div>

		<nav class="fixed top-0 left-0 right-0 z-50 bg-white/40 backdrop-blur-md border-b border-white/20">
		    <div class="max-w-6xl mx-auto px-8 h-20 flex items-center justify-between">
		        <a href="/Smart-Stadium-Staff-App---PEI/" class="flex items-center gap-3 group">
		            <img src={logoImage} alt="OpsLite Logo" class="h-10 w-auto rounded-lg shadow-sm group-hover:scale-105 transition-transform" />
		            <span class="font-black tracking-tighter text-slate-900 uppercase">OpsLite</span>
		        </a>
			
		        <div class="hidden md:flex items-center gap-8 text-[10px] font-bold tracking-[0.2em] uppercase text-slate-600">
		            <a href="/Smart-Stadium-Staff-App---PEI/overview" class="text-blue-700 transition-colors">Overview</a>
		            <a href="/Smart-Stadium-Staff-App---PEI/team" class="hover:text-blue-700 transition-colors">Team</a>
					
		            <div class="relative group/dropdown py-4">
		                <button class="flex items-center gap-1 uppercase tracking-[0.2em] hover:text-blue-700 transition-colors cursor-default">
		                    Milestones
		                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover/dropdown:rotate-180 transition-transform">
		                        <path d="m6 9 6 6 6-6"/>
		                    </svg>
		                </button>
					
		                <div class="absolute top-full left-1/2 -translate-x-1/2 w-48 pt-2 invisible opacity-0 group-hover/dropdown:visible group-hover/dropdown:opacity-100 transition-all duration-200">
		                    <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-2xl shadow-xl p-2 flex flex-col gap-1">
		                        <a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-1" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 1</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-2" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 2</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-2_1" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 2.1.</a>
								<a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-2_2" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 2.2.</a>
								<a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-3" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 3</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-4" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 4</a>
								<a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-5" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 5</a>
								<a href="/Smart-Stadium-Staff-App---PEI/milestones/milestone-6" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Milestone 6</a>
		                    </div>
		                </div>
		            </div>
				
		            <div class="relative group/dropdown py-4">
		                <button class="flex items-center gap-1 uppercase tracking-[0.2em] hover:text-blue-700 transition-colors cursor-default">
		                    Documents
		                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover/dropdown:rotate-180 transition-transform">
		                        <path d="m6 9 6 6 6-6"/>
		                    </svg>
		                </button>
					
		                <div class="absolute top-full left-1/2 -translate-x-1/2 w-48 pt-2 invisible opacity-0 group-hover/dropdown:visible group-hover/dropdown:opacity-100 transition-all duration-200">
		                    <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-2xl shadow-xl p-2 flex flex-col gap-1">
		                        <a href="/Smart-Stadium-Staff-App---PEI/documents/use-cases" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Use Cases</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/documents/architecture" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Architecture</a>
		                        <a href="/Smart-Stadium-Staff-App---PEI/documents/api" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">API</a>
								<a href="/Smart-Stadium-Staff-App---PEI/documents/poster" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Poster</a> 
		                    </div>
		                </div>
		            </div>

					<div class="relative group/dropdown py-4"> 
		                <button class="flex items-center gap-1 uppercase tracking-[0.2em] hover:text-blue-700 transition-colors cursor-default">
		                    Videos 
		                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover/dropdown:rotate-180 transition-transform">
		                        <path d="m6 9 6 6 6-6"/> 
		                    </svg>
		                </button>
					
		                <div class="absolute top-full left-1/2 -translate-x-1/2 w-48 pt-2 invisible opacity-0 group-hover/dropdown:visible group-hover/dropdown:opacity-100 transition-all duration-200">
		                    <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-2xl shadow-xl p-2 flex flex-col gap-1"> 
		                        <a href="/Smart-Stadium-Staff-App---PEI/videos/demo" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Demo</a> 
		                        <a href="/Smart-Stadium-Staff-App---PEI/videos/promotional" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Promotional</a> 
		                    </div>
		                </div>
		            </div>
		        </div>
		    </div>
		</nav>

		<main class="min-h-screen flex flex-col px-8 pt-28 pb-6 max-w-6xl mx-auto relative">
			
			<div class="flex-grow flex flex-col gap-16">
				
				<header class="mt-8">
					<h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-[0.9] text-slate-950 uppercase">
						Project <span class="text-blue-700 font-black">Vision</span>
					</h1>
					<div class="h-2 w-20 bg-blue-700 mt-6 rounded-full"></div>
				</header>

				<section>
					<h2 class="text-[10px] font-bold tracking-[0.5em] text-blue-700 uppercase mb-4">Executive Summary</h2>
					<p class="text-xl md:text-2xl text-slate-900 leading-relaxed font-normal italic max-w-4xl">
						Smart Stadium OpsLite transforms stadium staff operations from <span class="text-blue-800 font-semibold not-italic">reactive to predictive</span>, enabling proactive management of crowd dynamics and emergency situations.
					</p>
				</section>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
					
					{}
					<div class="space-y-8">
						<div>
							<h2 class="text-[10px] font-bold tracking-[0.5em] text-slate-500 uppercase mb-6">Technology Stack</h2>
							<div class="grid gap-4">
								{techStack.map(group => (
									<div class="p-6 bg-white/40 backdrop-blur-md border border-white/60 rounded-[2rem] shadow-sm">
										<h3 class="text-[10px] font-black text-blue-700 uppercase tracking-[0.2em] mb-5 opacity-80">{group.category}</h3>
										<div class="space-y-4">
											{group.items.map(item => (
												<div class="flex items-center justify-between group">
													<div class="flex items-center gap-3">
                                                        {item.icon ? (
                                                            <span class="tech-svg-container block leading-none" set:html={getIconWithColor(item.icon)} />
                                                        ) : (
                                                            
                                                            <div class="w-4 h-4 rounded-full bg-blue-600/20 border-2 border-blue-600/40 flex items-center justify-center">
                                                                <div class="w-1.5 h-1.5 rounded-full bg-blue-700"></div>
                                                            </div>
                                                        )}
														<span class="text-sm font-bold text-slate-900 tracking-tight">{item.name}</span>
													</div>
													<span class="text-[9px] font-mono text-slate-400 uppercase tracking-widest pl-4 text-right">{item.type}</span>
												</div>
											))}
										</div>
									</div>
								))}
							</div>
						</div>
					</div>

					{}
					<div class="space-y-8">
						<div>
							<h2 class="text-[10px] font-bold tracking-[0.5em] text-slate-500 uppercase mb-6">Success Metrics (KPIs)</h2>
							<div class="grid grid-cols-2 gap-4">
								{kpis.map(kpi => (
									<div class="p-6 bg-blue-700/5 backdrop-blur-md border border-blue-200/50 rounded-3xl flex flex-col items-center text-center">
										<span class="text-2xl font-black text-blue-700 mb-1">{kpi.value}</span>
										<span class="text-[10px] font-bold text-slate-900 uppercase tracking-tighter mb-1">{kpi.label}</span>
										<span class="text-[9px] text-slate-500 lowercase italic leading-none">{kpi.detail}</span>
									</div>
								))}
							</div>
						</div>

						<div class="p-6 bg-slate-900 rounded-3xl text-white shadow-xl relative overflow-hidden group">
                            <div class="absolute -top-10 -right-10 text-slate-800 opacity-30 group-hover:scale-110 group-hover:text-blue-900 transition-all duration-500">
                                <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                            </div>
							<h3 class="text-[10px] font-bold tracking-[0.3em] text-blue-400 uppercase mb-4 relative z-10">Business Impact</h3>
							<ul class="space-y-3 relative z-10">
								<li class="flex items-center gap-3 text-xs font-medium text-slate-100">
									<div class="h-1.5 w-1.5 rounded-full bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.8)]"></div>
									30% reduction in incident response time
								</li>
								<li class="flex items-center gap-3 text-xs font-medium text-slate-100">
									<div class="h-1.5 w-1.5 rounded-full bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.8)]"></div>
									25% improvement in staff utilization
								</li>
								<li class="flex items-center gap-3 text-xs font-medium text-slate-100">
									<div class="h-1.5 w-1.5 rounded-full bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.8)]"></div>
									40% faster evacuation coordination
								</li>
							</ul>
						</div>
					</div>

				</div>
			</div>

			<footer class="mt-auto border-t border-slate-300/50 relative z-10 w-full">
        	    <div class="max-w-6xl mx-auto px-8 py-4 flex flex-wrap gap-x-8 gap-y-2 text-slate-500 text-[10px] font-mono tracking-widest uppercase mb-2">
        	        <div class="flex gap-6">
        	            <span>PEI 2025/2026</span>
        	            <span class="font-bold text-slate-700">University of Aveiro</span>
        	        </div>
				
        	        <a 
        	            href="https://github.com/OpsLite-App" 
        	            target="_blank" 
        	            rel="noopener noreferrer" 
        	            class="ml-auto flex items-center gap-2 hover:text-blue-700 transition-colors group normal-case" 
        	        >
        	            <span class="text-slate-400 group-hover:text-blue-700 italic">GitHub</span>
        	            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70">
        	                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
        	                <path d="M9 18c-4.51 2-5-2-7-2"></path>
        	            </svg>
        	        </a>
        	    </div>
        	</footer>

		</main>
	</body>
</html>