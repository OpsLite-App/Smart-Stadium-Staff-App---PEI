---
import '../styles/global.css';

const backgroundImage = "/dragao.jpg";
const logoImage = "/logo.jpeg";

const teamData = [
  {
    name: "Cristiana Rebelo",
    role: "Project Manager & Coordinator",
    image: "/team/cristiana.jpeg",
    responsibilities: ["Project planning and coordination", "Documentation management", "UI/UX design oversight", "Client communication"]
  },
  {
    name: "Rodrigo Costa",
    role: "Mobile & UI Lead",
    image: "/team/rodrigo.jpeg",
    responsibilities: ["React application development", "Frontend architecture", "User interface implementation", "Cross-platform optimization"]
  },
  {
    name: "Guilherme Carreira",
    role: "Backend & API Lead",
    image: "/team/guilherme.jpeg",
    responsibilities: ["Server-side development", "WebSocket implementation", "Database design", "API contract specification"]
  },
  {
    name: "Solomiia Koba",
    role: "Modeling & Analytics Lead",
    image: "/team/solomiia.jpeg",
    responsibilities: ["Algorithm development", "Data modeling and analysis", "Performance optimization", "Mathematical modeling"]
  },
  {
    name: "Diogo Pinheiro",
    role: "CI & Testing Lead",
    image: "/team/diogo.png",
    responsibilities: ["Continuous integration", "Testing framework development", "Performance benchmarking", "Quality assurance"]
  }
];

// source: 12 - Mantida a ordenação
const team = teamData.sort((a, b) => a.name.localeCompare(b.name));
---

<html lang="pt">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Team | OpsLite</title>
		<link rel="icon" type="image/jpeg" href={logoImage} />
	</head>
	<body class="bg-slate-50 text-slate-900 antialiased font-sans flex flex-col min-h-screen">
		
		<div class="fixed inset-0 -z-10 overflow-hidden">
			<img src={backgroundImage} alt="Estádio do Dragão" class="w-full h-full object-cover opacity-35 shadow-inner" />
			<div class="absolute inset-0 bg-gradient-to-tr from-slate-50 via-slate-50/80 to-transparent"></div>
		</div>

		<nav class="fixed top-0 left-0 right-0 z-50 bg-white/40 backdrop-blur-md border-b border-white/20">
		    <div class="max-w-6xl mx-auto px-8 h-20 flex items-center justify-between">
		        <a href="/" class="flex items-center gap-3 group">
		            <img src={logoImage} alt="OpsLite Logo" class="h-10 w-auto rounded-lg shadow-sm group-hover:scale-105 transition-transform" />
		            <span class="font-black tracking-tighter text-slate-900 uppercase">OpsLite</span>
		        </a>
			
		        <div class="hidden md:flex items-center gap-8 text-[10px] font-bold tracking-[0.2em] uppercase text-slate-600">
		            <a href="/overview" class="hover:text-blue-700 transition-colors">Overview</a>
		            <a href="/team" class="hover:text-blue-700 transition-colors">Team</a>
		            <a href="/milestones" class="hover:text-blue-700 transition-colors">Milestones</a>
				
		            <div class="relative group/dropdown py-4">
		                <button class="flex items-center gap-1 uppercase tracking-[0.2em] hover:text-blue-700 transition-colors cursor-default">
		                    Documents
		                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 group-hover/dropdown:rotate-180 transition-transform">
		                        <path d="m6 9 6 6 6-6"/>
		                    </svg>
		                </button>
					
		                <div class="absolute top-full left-1/2 -translate-x-1/2 w-48 pt-2 invisible opacity-0 group-hover/dropdown:visible group-hover/dropdown:opacity-100 transition-all duration-200">
		                    <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-2xl shadow-xl p-2 flex flex-col gap-1">
		                        <a href="/documents/use-cases" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Use Cases</a>
		                        <a href="/documents/architecture" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">Architecture</a>
		                        <a href="/documents/api" class="px-4 py-2.5 rounded-xl hover:bg-blue-50 hover:text-blue-700 transition-colors normal-case tracking-normal text-xs font-semibold text-slate-700">API</a>
		                    </div>
		                </div>
		            </div>
		        </div>
		    </div>
		</nav>

		<main class="min-h-screen flex flex-col px-8 pt-28 pb-6 max-w-6xl mx-auto relative">
			
			<div class="flex-grow flex flex-col gap-12">
				
				<header class="mt-8">
					<h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-[0.9] text-slate-950 uppercase">
						Project	<span class="text-blue-700 font-black">Team</span>
					</h1>
					<div class="h-2 w-20 bg-blue-700 mt-6 rounded-full"></div>
				</header>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
					{team.map((member) => (
						<div class="group p-6 bg-white/40 backdrop-blur-md border border-white/60 rounded-3xl hover:bg-white/60 hover:border-blue-300 transition-all duration-300 shadow-sm flex flex-row items-center gap-6">
							<div class="w-20 h-20 md:w-30 md:h-30 bg-slate-200 rounded-2xl overflow-hidden border-2 border-white shadow-inner flex-shrink-0 transition-all">
								<img src={member.image} alt={member.name} class="w-full h-full object-cover transition-all" />
							</div>
							
							<div class="flex flex-col min-w-0">
								<h3 class="text-xl font-bold text-slate-950 mb-0.5 tracking-tight">{member.name}</h3>
								<p class="text-[10px] font-bold text-blue-700 uppercase tracking-widest mb-3 leading-tight">{member.role}</p>
								<ul class="space-y-1.5">
									{member.responsibilities.map((resp) => (
										<li class="text-xs text-slate-600 leading-snug flex items-start gap-2">
											<span class="text-blue-500 font-bold">•</span>
											<span>{resp}</span>
										</li>
									))}
								</ul>
							</div>
						</div>
					))}
				</div>

			</div>

			<footer class="mt-auto pt-4 border-t border-slate-300/50 flex flex-wrap gap-x-8 gap-y-2 text-slate-500 text-[10px] font-mono tracking-widest uppercase mb-2">
			    <div class="flex gap-6">
			        <span>PEI 2025/2026</span>
			        <span class="font-bold text-slate-700">University of Aveiro</span>
			    </div>
			
			    <a href="https://github.com/OpsLite-App" target="_blank" rel="noopener noreferrer" class="ml-auto flex items-center gap-2 hover:text-blue-700 transition-colors group normal-case">
				    <span class="text-slate-400 group-hover:text-blue-700 italic">GitHub</span>
				    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70">
				        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
				        <path d="M9 18c-4.51 2-5-2-7-2"></path>
				    </svg>
				</a>
			</footer>

		</main>
	</body>
</html>